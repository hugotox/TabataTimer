        "UIBackgroundModes": [
          "audio"
        ]
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.hugotox.TabataTimer"
    },
    "name": "TabataTimer",
    "orientation": "default",
    "slug": "TabataTimer",
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/801f9c3c-08af-4826-affc-4fd6d86ee022"
    },
    "userInterfaceStyle": "automatic",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "801f9c3c-08af-4826-affc-4fd6d86ee022"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#ffffff",
          "resizeMode": "contain",
          "imageWidth": 200
        }
