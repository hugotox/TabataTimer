{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "jest"
    ],
    "paths": {
      "assets/*": [
        "./src/assets/*"
      ],
      "components/*": [
        "./src/components/*"
      ],
      "routes": [
        "./src/routes"
      ],
      "routes/*": [
        "./src/routes/*"
      ],
      "screens/*": [
        "./src/screens/*"
      ],
      "store/*": [
        "./src/store/*"
      ],
      "theme": [
        "./src/theme"
      ],
      "theme/*": [
        "./src/theme/*"
      ],
      "utils": [
        "./src/utils"
      ],
      "utils/*": [
        "./src/utils/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
